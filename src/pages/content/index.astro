---
import Base from '../../layouts/Base.astro';
import Prompt from '../../components/Prompt.astro';
import data from '../../data/content-i-like.json';

// Generated by scripts/sync-vault.mjs from the vault's content-i-like/
// manifest section — do not hand-edit; re-run the sync instead.
const { sections } = data as {
  sections: { key: string; title: string; items: { text: string; url: string; summary?: string; pdf?: string }[] }[];
};
---

<Base
  title="Content — Barnaby Napier"
  section="content"
  description="Studies, articles, blogs, and sites I've read and liked."
>
  <Prompt cmd="content/" />
  <p class="out muted" style="font-size:13px">
    studies, articles, blogs &amp; sites i've read and liked.
  </p>

  {
    sections.map((s) => (
      <section class="section" style="margin-top:1.8rem" id={s.key}>
        <h2 class="amber" style="font-size:15px;font-weight:500;margin:0 0 0.5rem">
          {s.title}
        </h2>
        {s.items.map((it) => (
          <div style="margin:0 0 0.9rem">
            <p class="out" style="margin:0">
              <a href={it.pdf ?? it.url} target="_blank" rel="noopener noreferrer">
                {it.text}
              </a>
            </p>
            {it.summary && (
              <p class="out muted" style="margin:0;font-size:13px">{it.summary}</p>
            )}
          </div>
        ))}
      </section>
    ))
  }
</Base>
